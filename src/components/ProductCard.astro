---
import type { TechProduct } from '../lib/store';
interface Props { product: TechProduct; }
const { product } = Astro.props;
const primaryImage = product.images[0]?.url || '/images/appliance-hero.png';
const discount = product.compare_at_price ? Math.round(((product.compare_at_price - product.price) / product.compare_at_price) * 100) : 0;
---
<article class="group flex flex-col bg-white border border-[#e7e4de] rounded-2xl overflow-hidden hover:-translate-y-1 hover:shadow-xl hover:shadow-[#172640]/10 transition-all duration-300"><a href={`/product/${product.slug}`} class="relative block aspect-[4/3] overflow-hidden bg-[#edf0f1]"><img src={primaryImage} alt={product.title} loading="lazy" class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500" />{discount > 0 && <span class="absolute top-3 left-3 rounded-full bg-[#ef5b2a] px-2.5 py-1 text-[10px] font-black text-white">SAVE {discount}%</span>}<span class="absolute bottom-3 left-3 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold text-[#172640]">{product.category}</span></a><div class="p-5 flex flex-col flex-grow"><div class="flex items-center gap-1 text-xs"><span class="text-[#f4a62a]">★★★★★</span><span class="text-[#687386] ml-1">{product.rating} ({product.review_count})</span></div><h3 class="font-heading text-lg leading-tight font-extrabold text-[#172640] mt-3"><a href={`/product/${product.slug}`} class="hover:text-[#ef5b2a]">{product.title}</a></h3><p class="mt-2 text-xs leading-relaxed text-[#687386] line-clamp-2">{product.short_description}</p><div class="mt-auto pt-5 flex items-end justify-between gap-2"><div><p class="font-heading text-xl font-black text-[#172640]">Rs. {product.price.toLocaleString()}</p>{product.compare_at_price && <p class="text-[11px] text-[#8e96a3] line-through">Rs. {product.compare_at_price.toLocaleString()}</p>}</div><button type="button" onclick={`window.addToAurexCart(${JSON.stringify(product)})`} aria-label={`Add ${product.title} to cart`} class="w-10 h-10 rounded-xl bg-[#172640] text-white hover:bg-[#ef5b2a] transition-colors text-xl">+</button></div></div></article>
