---
const navLinks = [{ name: 'Shop all', href: '/products' }, { name: 'Fans & cooling', href: '/products?category=fans-cooling' }, { name: 'Kitchen', href: '/products?category=kitchen-appliances' }, { name: 'Tech', href: '/products?category=tech-computing' }, { name: 'Support', href: '/warranty' }];
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-[#e7e4de]"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[76px] flex items-center justify-between gap-5"><a href="/" class="flex items-center gap-2.5"><span class="grid place-items-center w-9 h-9 rounded-xl bg-[#ef5b2a] text-white font-black text-xl">A</span><span class="font-heading text-2xl font-black tracking-[-.06em] text-[#172640]">aurex</span></a><nav class="hidden lg:flex items-center gap-6">{navLinks.map(link => <a href={link.href} class="text-[13px] font-bold text-[#42516a] hover:text-[#ef5b2a] transition-colors">{link.name}</a>)}</nav><div class="flex items-center gap-2"><a href="/products" class="hidden sm:flex p-2 text-[#172640]" aria-label="Search products">⌕</a><button type="button" id="aurex-cart-btn" onclick="window.openAurexCart()" class="flex items-center gap-2 px-3 py-2 rounded-lg bg-[#172640] text-white text-xs font-bold">Bag <span id="aurex-header-cart-count" class="grid place-items-center min-w-5 h-5 rounded-full bg-[#f4a62a] text-[#172640]">0</span></button><button type="button" id="aurex-mobile-toggle" class="lg:hidden p-2 text-[#172640]" aria-label="Toggle navigation">☰</button></div></div><div id="aurex-mobile-menu" class="hidden lg:hidden border-t border-[#e7e4de] px-4 py-3 bg-white">{navLinks.map(link => <a href={link.href} class="block py-2.5 text-sm font-bold text-[#42516a]">{link.name}</a>)}</div></header>
<script is:inline>function updateAurexHeaderCart(){const b=document.getElementById('aurex-header-cart-count');if(b&&window.getAurexCart)b.textContent=window.getAurexCart().reduce((n,i)=>n+(i.quantity||1),0)}window.addEventListener('DOMContentLoaded',updateAurexHeaderCart);window.addEventListener('aurex:cart_updated',updateAurexHeaderCart);document.getElementById('aurex-mobile-toggle')?.addEventListener('click',()=>document.getElementById('aurex-mobile-menu')?.classList.toggle('hidden'));</script>
