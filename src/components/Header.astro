---
const navLinks = [
  { name: "Home", href: "/" },
  { name: "All Products", href: "/products" },
  { name: "Audio & Sound", href: "/products?category=audio-headphones" },
  { name: "Wearables", href: "/products?category=smart-wearables" },
  { name: "Computing", href: "/products?category=laptops-computing" },
  { name: "Warranty & Support", href: "/warranty" },
];
---

<header class="sticky top-0 z-40 bg-[#080d1a]/95 backdrop-blur-md border-b border-[#1e293b]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-4">
        <a href="/" class="flex items-center gap-3 group">
          <img src="/images/logo.jpg" alt="Aurex Tech Logo" class="h-11 w-11 rounded-lg object-cover border border-[#06b6d4]/40 shadow-lg shadow-[#06b6d4]/10 group-hover:border-[#06b6d4] transition-all" />
          <div class="flex flex-col">
            <span class="font-tech text-2xl font-black tracking-widest text-white uppercase group-hover:text-[#38bdf8] transition-colors flex items-center gap-1">
              AUREX
              <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4] inline-block"></span>
            </span>
            <span class="text-[9px] tracking-[0.25em] uppercase text-[#64748b] -mt-1 font-semibold">Flagship Electronics LK</span>
          </div>
        </a>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center space-x-6">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-xs font-semibold tracking-wider uppercase text-[#94a3b8] hover:text-[#38bdf8] transition-colors py-1 relative hover:after:w-full after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-[#06b6d4] after:transition-all"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Right Header Actions -->
      <div class="flex items-center space-x-4">
        <!-- Search Trigger -->
        <a href="/products" class="p-2 text-[#94a3b8] hover:text-white transition-colors" title="Search gadgets">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>

        <!-- Cart Button -->
        <button
          type="button"
          id="aurex-cart-btn"
          class="relative flex items-center gap-2 px-3 py-2 bg-[#0f172a] hover:bg-[#1e293b] border border-[#334155] rounded-lg text-xs font-semibold text-white transition-all"
          onclick="window.openAurexCart()"
        >
          <svg class="w-4 h-4 text-[#38bdf8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="hidden sm:inline">Cart</span>
          <span
            id="aurex-header-cart-count"
            class="inline-flex items-center justify-center px-1.5 py-0.5 text-[10px] font-bold text-black bg-[#38bdf8] rounded-full min-w-[18px]"
          >
            0
          </span>
        </button>

        <!-- Mobile Nav Toggle -->
        <button
          type="button"
          id="aurex-mobile-toggle"
          class="lg:hidden p-2 text-[#94a3b8] hover:text-white"
          aria-label="Toggle Navigation"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile menu dropdown -->
  <div id="aurex-mobile-menu" class="hidden lg:hidden bg-[#0c1322] border-b border-[#1e293b] px-4 pt-2 pb-6 space-y-3">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block text-sm font-semibold tracking-wider uppercase text-[#cbd5e1] hover:text-[#38bdf8] py-2 border-b border-[#1e293b]/70"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-2 flex justify-between items-center text-xs text-[#64748b]">
      <span>Store: Sri Lanka LKR</span>
      <a href="/cart" class="text-[#38bdf8] font-bold">Open Cart &rarr;</a>
    </div>
  </div>
</header>

<script is:inline>
  function updateAurexHeaderCart() {
    const badge = document.getElementById('aurex-header-cart-count');
    if (badge && window.getAurexCart) {
      const cart = window.getAurexCart();
      const count = cart.reduce((acc, item) => acc + (item.quantity || 1), 0);
      badge.textContent = count;
    }
  }

  window.addEventListener('DOMContentLoaded', updateAurexHeaderCart);
  window.addEventListener('aurex:cart_updated', updateAurexHeaderCart);

  document.getElementById('aurex-mobile-toggle')?.addEventListener('click', () => {
    document.getElementById('aurex-mobile-menu')?.classList.toggle('hidden');
  });
</script>
