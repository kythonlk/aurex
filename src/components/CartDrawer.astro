---
---

<div id="aurex-cart-overlay" class="fixed inset-0 z-50 bg-black/75 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-300"></div>

<aside
  id="aurex-cart-drawer"
  class="fixed top-0 right-0 z-50 h-full w-full max-w-md bg-[#080d1a] shadow-2xl border-l border-[#1e293b] transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col"
  aria-label="Aurex Cart Drawer"
>
  <!-- Header -->
  <div class="px-6 py-5 border-b border-[#1e293b] flex items-center justify-between bg-[#0b1220]">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-[#06b6d4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
      <h2 class="font-tech text-lg font-bold uppercase tracking-wider text-white">Hardware Cart</h2>
    </div>
    <button
      type="button"
      id="aurex-close-cart-btn"
      class="text-[#64748b] hover:text-white p-1"
      onclick="window.closeAurexCart()"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Cart List Container -->
  <div id="aurex-cart-drawer-items" class="flex-grow overflow-y-auto px-6 py-4 space-y-4">
    <!-- Populated dynamically via JS -->
  </div>

  <!-- Footer -->
  <div class="p-6 border-t border-[#1e293b] bg-[#0b1220] space-y-4">
    <div class="flex justify-between items-baseline">
      <span class="text-xs uppercase tracking-wider text-[#64748b] font-bold">Subtotal</span>
      <span id="aurex-cart-subtotal" class="font-tech text-2xl font-black text-white">Rs. 0</span>
    </div>

    <p class="text-[11px] text-[#64748b]">
      Official warranty certificate and serial registration included with all dispatches.
    </p>

    <div class="grid grid-cols-2 gap-3 pt-2">
      <a
        href="/cart"
        class="block text-center py-3 px-4 border border-[#334155] hover:border-[#06b6d4] text-[#cbd5e1] hover:text-white text-xs font-bold tracking-wider uppercase transition-colors rounded-lg"
      >
        View Full Cart
      </a>
      <a
        href="/checkout"
        class="block text-center py-3 px-4 bg-[#06b6d4] hover:bg-[#0891b2] text-black text-xs font-black tracking-wider uppercase transition-colors rounded-lg shadow-lg shadow-[#06b6d4]/20"
      >
        Checkout Now
      </a>
    </div>
  </div>
</aside>

<script is:inline>
  window.openAurexCart = function() {
    const drawer = document.getElementById('aurex-cart-drawer');
    const overlay = document.getElementById('aurex-cart-overlay');
    if (drawer && overlay) {
      window.renderAurexCartDrawer();
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      drawer.classList.remove('translate-x-full');
    }
  };

  window.closeAurexCart = function() {
    const drawer = document.getElementById('aurex-cart-drawer');
    const overlay = document.getElementById('aurex-cart-overlay');
    if (drawer && overlay) {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      drawer.classList.add('translate-x-full');
    }
  };

  document.getElementById('aurex-cart-overlay')?.addEventListener('click', window.closeAurexCart);

  window.renderAurexCartDrawer = function() {
    const container = document.getElementById('aurex-cart-drawer-items');
    const subtotalEl = document.getElementById('aurex-cart-subtotal');
    if (!container || !subtotalEl) return;

    const cart = window.getAurexCart ? window.getAurexCart() : [];
    if (cart.length === 0) {
      container.innerHTML = `
        <div class="text-center py-16 text-[#64748b]">
          <p class="font-tech text-base mb-2">Your hardware cart is empty</p>
          <a href="/products" onclick="window.closeAurexCart()" class="inline-block mt-3 text-xs uppercase tracking-wider font-bold text-[#38bdf8] underline">
            Browse Flagship Gear &rarr;
          </a>
        </div>
      `;
      subtotalEl.textContent = 'Rs. 0';
      return;
    }

    let subtotal = 0;
    container.innerHTML = cart.map((item, idx) => {
      const itemTotal = item.price * (item.quantity || 1);
      subtotal += itemTotal;
      const img = item.images && item.images[0] ? item.images[0].url : '/images/headphones.jpg';
      return `
        <div class="flex gap-4 p-3 bg-[#0b1220] border border-[#1e293b] rounded-lg">
          <img src="${img}" alt="${item.title}" class="w-16 h-16 object-cover rounded-md border border-[#1e293b]" />
          <div class="flex-grow flex flex-col justify-between">
            <div>
              <h4 class="font-tech text-xs font-bold text-white line-clamp-1">${item.title}</h4>
              <p class="text-[11px] text-[#38bdf8] font-bold mt-0.5">Rs. ${(item.price).toLocaleString()}</p>
            </div>
            <div class="flex items-center justify-between mt-2 pt-1 border-t border-[#1e293b]">
              <div class="flex items-center border border-[#334155] rounded-md bg-[#080d1a] text-xs">
                <button type="button" class="px-2 py-0.5 hover:text-[#38bdf8]" onclick="window.changeAurexCartQty(${idx}, -1)">-</button>
                <span class="px-2 font-bold">${item.quantity || 1}</span>
                <button type="button" class="px-2 py-0.5 hover:text-[#38bdf8]" onclick="window.changeAurexCartQty(${idx}, 1)">+</button>
              </div>
              <button type="button" class="text-[11px] text-rose-400 hover:underline" onclick="window.removeAurexCartItem(${idx})">Remove</button>
            </div>
          </div>
        </div>
      `;
    }).join('');

    subtotalEl.textContent = `Rs. ${subtotal.toLocaleString()}`;
  };

  window.changeAurexCartQty = function(index, delta) {
    const cart = window.getAurexCart();
    if (!cart[index]) return;
    cart[index].quantity = (cart[index].quantity || 1) + delta;
    if (cart[index].quantity <= 0) {
      cart.splice(index, 1);
    }
    window.saveAurexCart(cart);
    window.renderAurexCartDrawer();
  };

  window.removeAurexCartItem = function(index) {
    const cart = window.getAurexCart();
    cart.splice(index, 1);
    window.saveAurexCart(cart);
    window.renderAurexCartDrawer();
  };
</script>
