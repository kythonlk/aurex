---
---

<footer class="bg-[#04070e] text-[#94a3b8] pt-16 pb-12 border-t border-[#1e293b]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-[#1e293b]">
      
      <!-- Brand column -->
      <div class="space-y-4 md:col-span-1">
        <div class="flex items-center gap-3">
          <img src="/images/logo.jpg" alt="Aurex" class="h-9 w-9 rounded-lg border border-[#06b6d4]/40" />
          <span class="font-tech text-2xl font-black text-white tracking-wider">AUREX</span>
        </div>
        <p class="text-xs leading-relaxed text-[#64748b]">
          Sri Lanka's flagship hardware retailer for studio acoustic engineering, titanium wearable sensors, and OLED ultrabook computing.
        </p>
        <div class="flex items-center gap-2 text-xs font-semibold text-[#38bdf8]">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Official Authorized Retailer</span>
        </div>
      </div>

      <!-- Categories -->
      <div>
        <h4 class="font-tech text-xs uppercase tracking-[0.2em] text-white font-bold mb-4">Hardware Lines</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/products?category=audio-headphones" class="hover:text-[#38bdf8] transition-colors">Pulse Pro ANC Headphones</a></li>
          <li><a href="/products?category=smart-wearables" class="hover:text-[#38bdf8] transition-colors">Cyberwatch Titanium AMOLED</a></li>
          <li><a href="/products?category=laptops-computing" class="hover:text-[#38bdf8] transition-colors">Blade Pro 14 OLED Ultrabooks</a></li>
          <li><a href="/products" class="hover:text-[#38bdf8] transition-colors">Gaming & Esports Peripherals</a></li>
          <li><a href="/products" class="hover:text-[#38bdf8] transition-colors">Thunderbolt & USB4 Docks</a></li>
        </ul>
      </div>

      <!-- Assurance & Service -->
      <div>
        <h4 class="font-tech text-xs uppercase tracking-[0.2em] text-white font-bold mb-4">Sri Lanka Assurance</h4>
        <ul class="space-y-2 text-xs">
          <li><span class="text-[#38bdf8]">✓</span> 2-Year Comprehensive Warranty</li>
          <li><span class="text-[#38bdf8]">✓</span> TRCSL Approved Radios</li>
          <li><span class="text-[#38bdf8]">✓</span> 3-Month 0% via Koko & Mintpay</li>
          <li><span class="text-[#38bdf8]">✓</span> Islandwide 24-48h Prompt Courier</li>
          <li><a href="/warranty" class="text-[#38bdf8] hover:underline">Warranty Claim Centers</a></li>
        </ul>
      </div>

      <!-- Tech Dispatch -->
      <div>
        <h4 class="font-tech text-xs uppercase tracking-[0.2em] text-white font-bold mb-4">Firmware & Drop Alerts</h4>
        <p class="text-xs text-[#64748b] mb-3 leading-relaxed">
          Be first to receive limited batch drop notifications and exclusive pre-order pricing.
        </p>
        <form class="space-y-2" onsubmit="event.preventDefault(); alert('Subscribed to Aurex Hardware Drops.');">
          <input
            type="email"
            placeholder="Enter tech email"
            required
            class="w-full bg-[#0b1220] border border-[#1e293b] px-3.5 py-2 text-xs text-white placeholder-[#475569] rounded-md focus:outline-none focus:border-[#06b6d4]"
          />
          <button
            type="submit"
            class="w-full bg-[#06b6d4] hover:bg-[#0891b2] text-black font-bold py-2 text-xs uppercase tracking-wider rounded-md transition-colors"
          >
            Subscribe
          </button>
        </form>
      </div>

    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-[11px] text-[#475569] gap-4">
      <p>© {new Date().getFullYear()} Aurex Retail Electronics Sri Lanka. All rights reserved.</p>
      <div class="flex items-center space-x-6">
        <a href="/warranty" class="hover:text-white">Service Centers</a>
        <a href="/products" class="hover:text-white">Product Directory</a>
        <span class="text-[#06b6d4] font-medium">Colombo • Kandy • Galle</span>
      </div>
    </div>
  </div>
</footer>
