---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Official 2-Year Warranty & Service Centers | Aurex Sri Lanka">
  <div class="bg-[#060a14] py-16 border-b border-[#1e293b] text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-4">
      <span class="text-xs uppercase tracking-[0.25em] font-mono text-[#06b6d4] font-bold">OFFICIAL SUPPORT & PROTECTION</span>
      <h1 class="font-tech text-4xl sm:text-5xl text-white font-black">2-Year Official Sri Lanka Warranty</h1>
      <p class="text-xs sm:text-sm text-[#94a3b8] leading-relaxed max-w-xl mx-auto">
        Every Aurex hardware device is registered in our centralized national database with complete component and battery coverage.
      </p>
    </div>
  </div>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    
    <!-- Coverage Features -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-[#0b1220] p-6 rounded-xl border border-[#1e293b] space-y-3">
        <div class="w-12 h-12 rounded-lg bg-[#06b6d4]/10 text-[#06b6d4] flex items-center justify-center font-bold text-xl">
          🔄
        </div>
        <h3 class="font-tech text-lg font-bold text-white">14-Day 1-to-1 Replacement</h3>
        <p class="text-xs text-[#94a3b8] leading-relaxed">
          If any manufacturer defect occurs within the first 14 days of purchase, receive an instant sealed brand-new unit with zero questions asked.
        </p>
      </div>

      <div class="bg-[#0b1220] p-6 rounded-xl border border-[#1e293b] space-y-3">
        <div class="w-12 h-12 rounded-lg bg-[#06b6d4]/10 text-[#06b6d4] flex items-center justify-center font-bold text-xl">
          🔋
        </div>
        <h3 class="font-tech text-lg font-bold text-white">Battery & Logic Board Care</h3>
        <p class="text-xs text-[#94a3b8] leading-relaxed">
          Comprehensive 24-month coverage on titanium smartwatch motherboards, OLED laptop displays, and headphone lithium-polymer battery health.
        </p>
      </div>

      <div class="bg-[#0b1220] p-6 rounded-xl border border-[#1e293b] space-y-3">
        <div class="w-12 h-12 rounded-lg bg-[#06b6d4]/10 text-[#06b6d4] flex items-center justify-center font-bold text-xl">
          🏢
        </div>
        <h3 class="font-tech text-lg font-bold text-white">Islandwide Service Hubs</h3>
        <p class="text-xs text-[#94a3b8] leading-relaxed">
          Walk-in diagnosis and genuine spare parts available at certified Aurex service lounges in Colombo 03, Kandy City Centre, and Galle Fort.
        </p>
      </div>
    </div>

    <!-- Serial Lookup Form -->
    <div class="bg-[#0b1220] p-8 rounded-2xl border border-[#06b6d4]/40 shadow-2xl max-w-2xl mx-auto text-center space-y-6">
      <h2 class="font-tech text-2xl font-bold text-white">Verify Hardware Serial & Warranty</h2>
      <p class="text-xs text-[#94a3b8]">
        Enter the 12-digit serial number printed on the base of your device box or invoice.
      </p>

      <form class="flex gap-3 max-w-md mx-auto" onsubmit="event.preventDefault(); document.getElementById('warranty-res').classList.remove('hidden');">
        <input
          type="text"
          placeholder="e.g. AUR-2026-9874"
          required
          class="flex-grow px-4 py-3 bg-[#080d1a] border border-[#1e293b] rounded-lg text-xs font-mono text-white focus:outline-none focus:border-[#06b6d4]"
        />
        <button
          type="submit"
          class="px-6 py-3 bg-[#06b6d4] hover:bg-[#0891b2] text-black font-black text-xs uppercase tracking-wider rounded-lg font-tech transition-colors"
        >
          Check Status
        </button>
      </form>

      <div id="warranty-res" class="hidden p-4 bg-[#080d1a] border border-emerald-500/40 rounded-xl text-left space-y-2 text-xs">
        <div class="flex items-center gap-2 text-emerald-400 font-bold">
          <span>✓</span>
          <span>Official Sri Lanka Warranty Active</span>
        </div>
        <p class="text-[#cbd5e1]">Coverage: 24 Months Genuine Hardware & Replacement Protection</p>
        <p class="text-[#64748b]">Registered to: Colombo Authorized Dispatch</p>
      </div>
    </div>

  </section>
</Layout>
