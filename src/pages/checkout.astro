---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hardware Checkout | Aurex Sri Lanka">
  <div class="bg-[#060a14] py-10 border-b border-[#1e293b]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-tech text-3xl sm:text-4xl text-white font-black">
        Hardware Checkout
      </h1>
      <p class="text-xs text-[#94a3b8] mt-1">Dispatched directly from Colombo Central Logistics Hub.</p>
    </div>
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <form id="aurex-checkout-form" class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      
      <!-- Checkout Details Form -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Contact -->
        <div class="bg-[#0b1220] p-6 rounded-xl border border-[#1e293b] shadow-xl space-y-4">
          <h2 class="font-tech text-lg font-bold text-white pb-2 border-b border-[#1e293b]">
            1. Customer Credentials
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[11px] uppercase tracking-wider text-[#64748b] font-bold mb-1">Email *</label>
              <input type="email" required placeholder="tech@domain.com" class="w-full px-3.5 py-2.5 text-xs bg-[#080d1a] border border-[#1e293b] rounded-lg text-white focus:outline-none focus:border-[#06b6d4]" />
            </div>
            <div>
              <label class="block text-[11px] uppercase tracking-wider text-[#64748b] font-bold mb-1">Sri Lanka Mobile *</label>
              <input type="tel" required placeholder="+94 77 123 4567" class="w-full px-3.5 py-2.5 text-xs bg-[#080d1a] border border-[#1e293b] rounded-lg text-white focus:outline-none focus:border-[#06b6d4]" />
            </div>
          </div>
        </div>

        <!-- Shipping Destination -->
        <div class="bg-[#0b1220] p-6 rounded-xl border border-[#1e293b] shadow-xl space-y-4">
          <h2 class="font-tech text-lg font-bold text-white pb-2 border-b border-[#1e293b]">
            2. Delivery Address
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[11px] uppercase tracking-wider text-[#64748b] font-bold mb-1">First Name *</label>
              <input type="text" required placeholder="First name" class="w-full px-3.5 py-2.5 text-xs bg-[#080d1a] border border-[#1e293b] rounded-lg text-white focus:outline-none focus:border-[#06b6d4]" />
            </div>
            <div>
              <label class="block text-[11px] uppercase tracking-wider text-[#64748b] font-bold mb-1">Last Name *</label>
              <input type="text" required placeholder="Last name" class="w-full px-3.5 py-2.5 text-xs bg-[#080d1a] border border-[#1e293b] rounded-lg text-white focus:outline-none focus:border-[#06b6d4]" />
            </div>
            <div class="sm:col-span-2">
              <label class="block text-[11px] uppercase tracking-wider text-[#64748b] font-bold mb-1">Street Address *</label>
              <input type="text" required placeholder="Street, house number, office" class="w-full px-3.5 py-2.5 text-xs bg-[#080d1a] border border-[#1e293b] rounded-lg text-white focus:outline-none focus:border-[#06b6d4]" />
            </div>
            <div>
              <label class="block text-[11px] uppercase tracking-wider text-[#64748b] font-bold mb-1">City / Town *</label>
              <input type="text" required placeholder="e.g. Colombo, Rajagiriya, Kandy" class="w-full px-3.5 py-2.5 text-xs bg-[#080d1a] border border-[#1e293b] rounded-lg text-white focus:outline-none focus:border-[#06b6d4]" />
            </div>
            <div>
              <label class="block text-[11px] uppercase tracking-wider text-[#64748b] font-bold mb-1">District *</label>
              <select required class="w-full px-3.5 py-2.5 text-xs bg-[#080d1a] border border-[#1e293b] rounded-lg text-white focus:outline-none focus:border-[#06b6d4]">
                <option value="Colombo">Colombo (Same-Day / Next-Day)</option>
                <option value="Gampaha">Gampaha</option>
                <option value="Kalutara">Kalutara</option>
                <option value="Kandy">Kandy</option>
                <option value="Galle">Galle</option>
                <option value="Other">Other Islandwide District</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Payment Mode -->
        <div class="bg-[#0b1220] p-6 rounded-xl border border-[#1e293b] shadow-xl space-y-4">
          <h2 class="font-tech text-lg font-bold text-white pb-2 border-b border-[#1e293b]">
            3. Payment Option
          </h2>
          <div class="space-y-3">
            <label class="flex items-start gap-3 p-3.5 border border-[#06b6d4] bg-[#06b6d4]/5 rounded-lg cursor-pointer">
              <input type="radio" name="tech_pay" value="cod" checked class="mt-1 text-[#06b6d4] focus:ring-[#06b6d4]" />
              <div>
                <span class="block text-xs font-bold text-white uppercase font-tech">Cash On Delivery (COD)</span>
                <span class="block text-[11px] text-[#94a3b8] mt-0.5">Pay in cash or credit card POS upon courier arrival at your doorstep.</span>
              </div>
            </label>

            <label class="flex items-start gap-3 p-3.5 border border-[#1e293b] hover:border-[#06b6d4] rounded-lg cursor-pointer transition-colors">
              <input type="radio" name="tech_pay" value="koko" class="mt-1 text-[#06b6d4] focus:ring-[#06b6d4]" />
              <div>
                <span class="block text-xs font-bold text-white uppercase font-tech flex items-center gap-2">
                  <span>Koko / Mintpay (3 Months 0% Interest)</span>
                  <span class="px-1.5 py-0.2 rounded-sm bg-[#8b5cf6] text-[10px] text-white font-bold">Split It</span>
                </span>
                <span class="block text-[11px] text-[#94a3b8] mt-0.5">Pay only 1/3 today with any debit or credit card, balance over 2 months.</span>
              </div>
            </label>

            <label class="flex items-start gap-3 p-3.5 border border-[#1e293b] hover:border-[#06b6d4] rounded-lg cursor-pointer transition-colors">
              <input type="radio" name="tech_pay" value="online" class="mt-1 text-[#06b6d4] focus:ring-[#06b6d4]" />
              <div>
                <span class="block text-xs font-bold text-white uppercase font-tech">Online Visa / Mastercard / Sampath Bank IPG</span>
                <span class="block text-[11px] text-[#94a3b8] mt-0.5">Direct encrypted checkout with instant receipt generation.</span>
              </div>
            </label>
          </div>
        </div>

      </div>

      <!-- Summary -->
      <div class="space-y-6">
        <div class="bg-[#0b1220] border border-[#1e293b] rounded-xl p-6 shadow-xl space-y-4">
          <h3 class="font-tech text-base font-bold text-white pb-2 border-b border-[#1e293b]">
            Hardware Items
          </h3>

          <div id="aurex-checkout-preview" class="space-y-2 max-h-56 overflow-y-auto"></div>

          <div class="pt-4 border-t border-[#1e293b] space-y-2 text-xs text-[#94a3b8]">
            <div class="flex justify-between">
              <span>Subtotal</span>
              <span id="aurex-checkout-subtotal" class="font-bold text-white">Rs. 0</span>
            </div>
            <div class="flex justify-between">
              <span>Delivery</span>
              <span class="text-emerald-400 font-bold">Tracked Express Free</span>
            </div>
            <div class="flex justify-between pt-2 border-t border-[#1e293b]">
              <span class="font-tech text-sm font-bold text-white">Amount Due</span>
              <span id="aurex-checkout-total" class="font-tech text-xl font-black text-white">Rs. 0</span>
            </div>
          </div>

          <button
            type="submit"
            class="w-full py-4 bg-[#06b6d4] hover:bg-[#0891b2] text-black font-black text-xs uppercase tracking-wider rounded-xl shadow-lg shadow-[#06b6d4]/20 transition-all font-tech"
          >
            Authorize & Dispatch Order
          </button>
        </div>
      </div>

    </form>
  </section>

  <!-- Success Modal -->
  <div id="aurex-success-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4 hidden">
    <div class="bg-[#0b1220] max-w-md w-full p-8 rounded-2xl text-center border border-[#06b6d4] shadow-2xl space-y-4">
      <div class="w-16 h-16 rounded-full bg-[#06b6d4]/20 text-[#06b6d4] flex items-center justify-center mx-auto text-2xl font-bold">
        ✓
      </div>
      <h3 class="font-tech text-2xl font-black text-white">Order Confirmed</h3>
      <p class="text-xs text-[#94a3b8] leading-relaxed">
        Your Aurex hardware order has been successfully queued for dispatch. Your 2-Year Official Warranty serial has been registered automatically.
      </p>
      <div class="pt-4">
        <a href="/" class="inline-block px-8 py-3 bg-[#06b6d4] hover:bg-[#0891b2] text-black text-xs font-black uppercase tracking-wider rounded-lg transition-colors font-tech">
          Return To Homepage
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    function renderAurexCheckout() {
      const preview = document.getElementById('aurex-checkout-preview');
      const subtotalEl = document.getElementById('aurex-checkout-subtotal');
      const totalEl = document.getElementById('aurex-checkout-total');
      if (!preview || !subtotalEl || !totalEl) return;

      const cart = window.getAurexCart ? window.getAurexCart() : [];
      let subtotal = 0;
      preview.innerHTML = cart.map(item => {
        const t = item.price * (item.quantity || 1);
        subtotal += t;
        return `
          <div class="flex justify-between items-center text-xs py-1">
            <span class="truncate max-w-[170px] text-[#cbd5e1]">${item.title} <span class="text-[#64748b]">x${item.quantity || 1}</span></span>
            <span class="font-bold text-white">Rs. ${t.toLocaleString()}</span>
          </div>
        `;
      }).join('');

      subtotalEl.textContent = `Rs. ${subtotal.toLocaleString()}`;
      totalEl.textContent = `Rs. ${subtotal.toLocaleString()}`;
    }

    document.getElementById('aurex-checkout-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      localStorage.removeItem('aurex_cart');
      window.dispatchEvent(new CustomEvent('aurex:cart_updated'));
      document.getElementById('aurex-success-modal')?.classList.remove('hidden');
    });

    window.addEventListener('DOMContentLoaded', renderAurexCheckout);
  </script>
</Layout>
