---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getAurexProducts } from '../lib/store';

const products = await getAurexProducts();
const featured = products.filter(p => p.is_featured);
---

<Layout title="Aurex | Flagship Electronics, Audio & Computing Sri Lanka">
  <!-- Hero Section -->
  <section class="relative min-h-[85vh] flex items-center bg-[#070a12] overflow-hidden border-b border-[#1e293b]">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero-banner.jpg"
        alt="Aurex Flagship Tech Banner"
        class="w-full h-full object-cover object-center opacity-40 filter brightness-95"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#070a12] via-[#070a12]/80 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="max-w-2xl space-y-6">
        
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#06b6d4]/10 border border-[#06b6d4]/30 text-[#38bdf8] text-xs uppercase tracking-widest font-mono">
          <span class="w-2 h-2 rounded-full bg-[#06b6d4] animate-ping"></span>
          NEXT-GEN HARDWARE ARCHITECTURE
        </div>

        <h1 class="font-tech text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-[1.05]">
          AUREX <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#38bdf8] via-[#06b6d4] to-[#a855f7]">
            FLAGSHIP TECH.
          </span>
        </h1>

        <p class="text-sm sm:text-base text-[#94a3b8] leading-relaxed max-w-xl font-normal">
          Engineered for extreme performance. Experience 45dB hybrid ANC headphones, aerospace titanium AMOLED smartwatches, and ultra-thin 2.8K OLED creator laptops backed by 2-year official Sri Lanka warranty.
        </p>

        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href="/products"
            class="px-8 py-4 bg-[#06b6d4] hover:bg-[#0891b2] text-black text-xs font-black uppercase tracking-wider transition-all rounded-lg shadow-lg shadow-[#06b6d4]/20 transform hover:-translate-y-0.5"
          >
            Explore Hardware Lineup
          </a>
          <a
            href="/warranty"
            class="px-8 py-4 bg-[#0f172a] hover:bg-[#1e293b] border border-[#334155] text-white text-xs font-bold uppercase tracking-wider transition-all rounded-lg"
          >
            Warranty & Service
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Sri Lanka Hardware Value Pillars -->
  <section class="py-12 bg-[#060a14] border-b border-[#1e293b]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        
        <div class="flex items-center gap-4 p-4 rounded-xl bg-[#0b1220] border border-[#1e293b]">
          <div class="w-10 h-10 rounded-lg bg-[#06b6d4]/10 text-[#06b6d4] flex items-center justify-center font-bold text-lg">
            🛡
          </div>
          <div>
            <h4 class="text-xs font-bold text-white uppercase font-tech">2-Year LK Warranty</h4>
            <p class="text-[11px] text-[#64748b]">Official parts & service replacement</p>
          </div>
        </div>

        <div class="flex items-center gap-4 p-4 rounded-xl bg-[#0b1220] border border-[#1e293b]">
          <div class="w-10 h-10 rounded-lg bg-[#06b6d4]/10 text-[#06b6d4] flex items-center justify-center font-bold text-lg">
            ⚡
          </div>
          <div>
            <h4 class="text-xs font-bold text-white uppercase font-tech">0% Installments</h4>
            <p class="text-[11px] text-[#64748b]">Pay in 3 via Koko or Mintpay</p>
          </div>
        </div>

        <div class="flex items-center gap-4 p-4 rounded-xl bg-[#0b1220] border border-[#1e293b]">
          <div class="w-10 h-10 rounded-lg bg-[#06b6d4]/10 text-[#06b6d4] flex items-center justify-center font-bold text-lg">
            📡
          </div>
          <div>
            <h4 class="text-xs font-bold text-white uppercase font-tech">TRCSL Certified</h4>
            <p class="text-[11px] text-[#64748b]">100% Genuine approved radios</p>
          </div>
        </div>

        <div class="flex items-center gap-4 p-4 rounded-xl bg-[#0b1220] border border-[#1e293b]">
          <div class="w-10 h-10 rounded-lg bg-[#06b6d4]/10 text-[#06b6d4] flex items-center justify-center font-bold text-lg">
            🚚
          </div>
          <div>
            <h4 class="text-xs font-bold text-white uppercase font-tech">Fast Courier</h4>
            <p class="text-[11px] text-[#64748b]">Islandwide secure delivery</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Hardware Categories Grid -->
  <section class="py-20 bg-[#080d1a]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs uppercase tracking-[0.2em] font-mono text-[#06b6d4] font-bold">CORE ECOSYSTEM</span>
          <h2 class="font-tech text-3xl sm:text-4xl text-white font-extrabold mt-1">
            Browse By Hardware Category
          </h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Category 1: Headphones -->
        <a href="/products?category=audio-headphones" class="group relative block aspect-[16/10] overflow-hidden rounded-2xl bg-[#0f172a] border border-[#1e293b] hover:border-[#06b6d4] transition-all">
          <img src="/images/headphones.jpg" alt="Audio & Headphones" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#080d1a] via-[#080d1a]/50 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6">
            <span class="text-[10px] font-mono uppercase tracking-wider text-[#38bdf8] font-bold">45dB Hybrid ANC</span>
            <h3 class="font-tech text-xl font-bold text-white mt-1">Audio & Headphones</h3>
            <p class="text-xs text-[#94a3b8] mt-1">Titanium drivers, 60h battery life, studio fidelity.</p>
          </div>
        </a>

        <!-- Category 2: Smartwatch -->
        <a href="/products?category=smart-wearables" class="group relative block aspect-[16/10] overflow-hidden rounded-2xl bg-[#0f172a] border border-[#1e293b] hover:border-[#06b6d4] transition-all">
          <img src="/images/smartwatch.jpg" alt="Smart Wearables" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#080d1a] via-[#080d1a]/50 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6">
            <span class="text-[10px] font-mono uppercase tracking-wider text-[#38bdf8] font-bold">Titanium & Sapphire</span>
            <h3 class="font-tech text-xl font-bold text-white mt-1">Smart Wearables</h3>
            <p class="text-xs text-[#94a3b8] mt-1">10ATM water resistance, dual-band GPS & ECG sensor.</p>
          </div>
        </a>

        <!-- Category 3: Laptop -->
        <a href="/products?category=laptops-computing" class="group relative block aspect-[16/10] overflow-hidden rounded-2xl bg-[#0f172a] border border-[#1e293b] hover:border-[#06b6d4] transition-all">
          <img src="/images/laptop.jpg" alt="Laptops & Computing" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#080d1a] via-[#080d1a]/50 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6">
            <span class="text-[10px] font-mono uppercase tracking-wider text-[#38bdf8] font-bold">2.8K 120Hz OLED</span>
            <h3 class="font-tech text-xl font-bold text-white mt-1">Laptops & Computing</h3>
            <p class="text-xs text-[#94a3b8] mt-1">1.2kg ultrabooks with 32GB RAM & all-day battery.</p>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-20 bg-[#060a14] border-t border-[#1e293b]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs uppercase tracking-[0.2em] font-mono text-[#06b6d4] font-bold">FLAGSHIP HARDWARE</span>
          <h2 class="font-tech text-3xl sm:text-4xl text-white font-extrabold mt-1">
            Featured Innovations
          </h2>
        </div>
        <a href="/products" class="mt-4 md:mt-0 text-xs font-bold uppercase tracking-wider text-[#38bdf8] hover:underline flex items-center gap-1 font-tech">
          View All Products 
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {featured.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>
</Layout>
