---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getAurexProducts } from '../lib/store';
const products = await getAurexProducts();
const featured = products.filter(p => p.is_featured).slice(0, 4);
const categories = [
  { icon: '✺', title: 'Fans & Cooling', copy: 'Stay cool, every day', href: '/products?category=fans-cooling', tone: 'bg-[#dce8ff]' },
  { icon: '◒', title: 'Rice Cookers', copy: 'Perfect meals made simple', href: '/products?category=kitchen-appliances', tone: 'bg-[#ffe5d3]' },
  { icon: '⌁', title: 'Ovens & Cooking', copy: 'Bring home the heat', href: '/products?category=kitchen-appliances', tone: 'bg-[#fff0b8]' },
  { icon: '▣', title: 'Tech Essentials', copy: 'Smart gear for life', href: '/products?category=tech-computing', tone: 'bg-[#d8f0e7]' },
];
---
<Layout title="Aurex | Appliances & Tech for Everyday Living">
  <section class="relative overflow-hidden bg-[#f6f1e8]"><div class="max-w-7xl mx-auto min-h-[620px] px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 items-center"><div class="relative z-10 py-16 lg:py-24 max-w-xl"><p class="eyebrow">APPLIANCES THAT KEEP UP</p><h1 class="font-heading text-5xl sm:text-6xl lg:text-7xl font-black tracking-[-.055em] leading-[.93] text-[#15233b] mt-5">More comfort.<br/><span class="text-[#ef5b2a]">More you.</span></h1><p class="mt-7 text-base sm:text-lg leading-relaxed text-[#526072] max-w-md">From the fan that gets you through a warm afternoon to the cooker that makes dinner easy—find dependable electricals and smart tech for every room.</p><div class="mt-9 flex flex-wrap gap-3"><a href="/products" class="btn-primary">Shop all products <span>→</span></a><a href="#categories" class="btn-secondary">Explore categories</a></div><div class="mt-12 flex gap-7 text-sm text-[#536174]"><span><b class="block text-[#172640] text-xl">2 years</b>warranty cover</span><span><b class="block text-[#172640] text-xl">Islandwide</b>delivery</span><span><b class="block text-[#172640] text-xl">Easy</b>installments</span></div></div><div class="absolute inset-y-0 right-0 w-full lg:w-[58%]"><img src="/images/appliance-hero.png" alt="Home appliances and technology from Aurex" class="w-full h-full object-cover object-center" /><div class="absolute inset-0 bg-gradient-to-r from-[#f6f1e8] via-[#f6f1e8]/15 to-transparent"></div></div></div></section>
  <section class="bg-[#172640] text-white py-4"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap justify-between gap-4 text-xs font-semibold tracking-wide uppercase"><span>✓ Genuine products</span><span>✓ Official warranty</span><span>✓ Secure payment</span><span>✓ Fast islandwide delivery</span></div></section>
  <section id="categories" class="py-20 bg-white"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="flex justify-between gap-6 items-end mb-9"><div><p class="eyebrow">SHOP YOUR HOME</p><h2 class="section-title">What are you looking for?</h2></div><a href="/products" class="hidden sm:block text-sm font-bold text-[#ef5b2a]">View all products →</a></div><div class="grid grid-cols-2 lg:grid-cols-4 gap-4">{categories.map((category) => <a href={category.href} class={`category-card ${category.tone}`}><span class="category-icon">{category.icon}</span><h3>{category.title}</h3><p>{category.copy}</p><span class="arrow">→</span></a>)}</div></div></section>
  <section class="py-20 bg-[#f7f7f5]"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10"><div><p class="eyebrow">POPULAR RIGHT NOW</p><h2 class="section-title">Made for everyday living.</h2></div><a href="/products" class="text-sm font-bold text-[#ef5b2a]">Shop the collection →</a></div><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">{featured.map((product) => <ProductCard product={product} />)}</div></div></section>
  <section class="py-16 bg-[#f4a62a]"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row gap-8 items-center justify-between"><div><p class="text-xs font-black tracking-[.18em] text-[#603200]">AUREX HOME PROMISE</p><h2 class="text-3xl sm:text-4xl font-black tracking-tight text-[#172640] mt-2">Helpful products. Human support.</h2><p class="mt-3 max-w-xl text-[#593713]">Need help choosing the right appliance? Our team is here before and after your purchase.</p></div><a href="/warranty" class="btn-dark">Learn about our warranty →</a></div></section>
</Layout>
