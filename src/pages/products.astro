---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getAurexProducts } from '../lib/store';

const products = await getAurexProducts();
const categories = [
  { name: "All Products", slug: "all" },
  { name: "Fans & Cooling", slug: "fans-cooling" },
  { name: "Kitchen Appliances", slug: "kitchen-appliances" },
  { name: "Tech & Computing", slug: "tech-computing" },
];
---

<Layout title="Shop Appliances & Tech | Aurex Sri Lanka">
  <div class="bg-[#f6f1e8] py-14 border-b border-[#e7e4de]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs uppercase tracking-[0.25em] text-[#ef5b2a] font-bold">FOR EVERY ROOM</span>
      <h1 class="font-heading text-4xl sm:text-5xl text-[#172640] font-black mt-2">
        Appliances & tech, made simple
      </h1>
      <p class="text-sm text-[#687386] max-w-xl mx-auto mt-3">
        Everyday essentials for your kitchen, home and workspace, all backed by dependable local support.
      </p>
    </div>
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Category Tabs -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-10">
      {categories.map((cat) => (
        <button
          type="button"
          class="aurex-cat-tab px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider transition-all border border-[#e7e4de] bg-white text-[#687386] hover:border-[#ef5b2a] hover:text-[#172640]"
          data-slug={cat.slug}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <!-- Product Grid -->
    <div id="aurex-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map((product) => (
        <div class="aurex-item" data-category={product.category_slug}>
          <ProductCard product={product} />
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    const tabs = document.querySelectorAll('.aurex-cat-tab');
    const items = document.querySelectorAll('.aurex-item');

    function filterTech(slug) {
      tabs.forEach(tab => {
        if (tab.getAttribute('data-slug') === slug) {
          tab.classList.add('bg-[#ef5b2a]', 'text-white', 'border-[#ef5b2a]');
          tab.classList.remove('bg-white', 'text-[#687386]', 'border-[#e7e4de]');
        } else {
          tab.classList.remove('bg-[#ef5b2a]', 'text-white', 'border-[#ef5b2a]');
          tab.classList.add('bg-white', 'text-[#687386]', 'border-[#e7e4de]');
        }
      });

      items.forEach(item => {
        const cat = item.getAttribute('data-category');
        if (slug === 'all' || cat === slug) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const slug = tab.getAttribute('data-slug');
        filterTech(slug);
        const url = new URL(window.location);
        if (slug === 'all') {
          url.searchParams.delete('category');
        } else {
          url.searchParams.set('category', slug);
        }
        window.history.pushState({}, '', url);
      });
    });

    const params = new URLSearchParams(window.location.search);
    filterTech(params.get('category') || 'all');
  </script>
</Layout>
