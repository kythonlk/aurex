---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hardware Cart | Aurex Sri Lanka">
  <div class="bg-[#060a14] py-10 border-b border-[#1e293b]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-tech text-3xl sm:text-4xl text-white font-black">
        Your Hardware Cart
      </h1>
      <p class="text-xs text-[#94a3b8] mt-1">Review your configuration before initiating dispatch.</p>
    </div>
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      
      <!-- Cart Table -->
      <div class="lg:col-span-2 space-y-6">
        <div id="aurex-cart-table" class="space-y-4">
          <!-- Populated by JS -->
          <div class="p-12 text-center bg-[#0b1220] border border-[#1e293b] rounded-xl">
            <p class="font-tech text-base text-white">Loading hardware cart...</p>
          </div>
        </div>

        <div class="flex justify-between items-center pt-4">
          <a href="/products" class="text-xs uppercase tracking-wider font-bold text-[#38bdf8] hover:underline flex items-center gap-2 font-tech">
            &larr; Return to Hardware Lineup
          </a>
          <button type="button" onclick="localStorage.removeItem('aurex_cart'); window.dispatchEvent(new CustomEvent('aurex:cart_updated')); renderAurexCart();" class="text-xs text-rose-400 hover:underline">
            Clear Entire Cart
          </button>
        </div>
      </div>

      <!-- Summary -->
      <div class="bg-[#0b1220] border border-[#1e293b] rounded-xl p-6 shadow-xl space-y-6 h-fit">
        <h2 class="font-tech text-lg font-bold text-white pb-3 border-b border-[#1e293b]">
          Order Breakdown
        </h2>

        <div class="space-y-3 text-xs text-[#94a3b8]">
          <div class="flex justify-between">
            <span>Hardware Subtotal</span>
            <span id="aurex-subtotal" class="font-bold text-white">Rs. 0</span>
          </div>

          <div class="flex justify-between">
            <span>Official 2-Year Warranty</span>
            <span class="text-emerald-400 font-bold">Included Free</span>
          </div>

          <div class="flex justify-between">
            <span>Islandwide Tracked Courier</span>
            <span class="text-emerald-400 font-bold">Free</span>
          </div>

          <div id="aurex-discount-row" class="hidden justify-between text-[#38bdf8] font-bold">
            <span>Promo Coupon</span>
            <span id="aurex-discount-val">- Rs. 0</span>
          </div>
        </div>

        <!-- Coupon input -->
        <div class="pt-4 border-t border-[#1e293b] space-y-2">
          <label for="aurex-coupon" class="block text-[11px] uppercase tracking-wider text-[#64748b] font-bold font-mono">Promo Code</label>
          <div class="flex gap-2">
            <input
              type="text"
              id="aurex-coupon"
              placeholder="e.g. AUREX5"
              class="flex-grow px-3 py-2 text-xs bg-[#080d1a] border border-[#1e293b] rounded-lg text-white uppercase focus:outline-none focus:border-[#06b6d4]"
            />
            <button
              type="button"
              id="aurex-coupon-btn"
              class="px-4 py-2 bg-[#06b6d4] hover:bg-[#0891b2] text-black text-xs font-black uppercase tracking-wider rounded-lg transition-colors"
            >
              Apply
            </button>
          </div>
          <p id="aurex-coupon-msg" class="text-[11px]"></p>
        </div>

        <!-- Total -->
        <div class="pt-4 border-t border-[#1e293b] flex justify-between items-baseline">
          <span class="text-xs uppercase tracking-wider font-bold text-white font-tech">Total Price</span>
          <span id="aurex-final-total" class="font-tech text-2xl font-black text-white">Rs. 0</span>
        </div>

        <a
          href="/checkout"
          class="block text-center py-4 bg-[#06b6d4] hover:bg-[#0891b2] text-black text-xs font-black uppercase tracking-wider rounded-xl shadow-lg shadow-[#06b6d4]/20 transition-all font-tech"
        >
          Proceed To Checkout
        </a>
      </div>

    </div>
  </section>

  <script is:inline>
    let techDiscount = 0;

    function renderAurexCart() {
      const container = document.getElementById('aurex-cart-table');
      const subtotalEl = document.getElementById('aurex-subtotal');
      const totalEl = document.getElementById('aurex-final-total');
      const discountRow = document.getElementById('aurex-discount-row');
      const discountVal = document.getElementById('aurex-discount-val');
      if (!container || !subtotalEl || !totalEl) return;

      const cart = window.getAurexCart ? window.getAurexCart() : [];
      if (cart.length === 0) {
        container.innerHTML = `
          <div class="p-16 text-center bg-[#0b1220] border border-[#1e293b] rounded-xl space-y-4">
            <h3 class="font-tech text-xl text-white font-bold">Your hardware cart is currently empty</h3>
            <p class="text-xs text-[#64748b]">Configure high-performance audio, computing, and wearables.</p>
            <a href="/products" class="inline-block mt-4 px-6 py-3 bg-[#06b6d4] text-black text-xs font-black uppercase tracking-wider rounded-lg">
              Explore Tech
            </a>
          </div>
        `;
        subtotalEl.textContent = 'Rs. 0';
        totalEl.textContent = 'Rs. 0';
        return;
      }

      let subtotal = 0;
      container.innerHTML = cart.map((item, idx) => {
        const itemTotal = item.price * (item.quantity || 1);
        subtotal += itemTotal;
        const img = item.images && item.images[0] ? item.images[0].url : '/images/headphones.jpg';
        return `
          <div class="flex flex-col sm:flex-row items-center gap-6 p-5 bg-[#0b1220] border border-[#1e293b] rounded-xl">
            <img src="${img}" alt="${item.title}" class="w-20 h-20 object-cover rounded-lg border border-[#1e293b]" />
            <div class="flex-grow space-y-1 text-center sm:text-left">
              <span class="text-[10px] uppercase tracking-wider text-[#38bdf8] font-bold font-mono">${item.category}</span>
              <h3 class="font-tech text-base font-bold text-white">${item.title}</h3>
              <p class="text-xs text-[#64748b]">Unit: Rs. ${item.price.toLocaleString()}</p>
            </div>
            <div class="flex items-center gap-4">
              <div class="flex items-center border border-[#334155] rounded-md bg-[#080d1a] text-xs">
                <button type="button" class="px-2.5 py-1 hover:text-[#38bdf8]" onclick="window.changeAurexCartQty(${idx}, -1); renderAurexCart();">-</button>
                <span class="px-3 font-bold text-white">${item.quantity || 1}</span>
                <button type="button" class="px-2.5 py-1 hover:text-[#38bdf8]" onclick="window.changeAurexCartQty(${idx}, 1); renderAurexCart();">+</button>
              </div>
              <span class="font-tech text-base font-extrabold text-white min-w-[100px] text-right">
                Rs. ${itemTotal.toLocaleString()}
              </span>
              <button type="button" class="text-rose-400 hover:text-rose-300 p-1" onclick="window.removeAurexCartItem(${idx}); renderAurexCart();">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </div>
          </div>
        `;
      }).join('');

      const discountAmt = Math.round(subtotal * techDiscount);
      const total = subtotal - discountAmt;

      subtotalEl.textContent = `Rs. ${subtotal.toLocaleString()}`;
      if (techDiscount > 0) {
        discountRow.classList.remove('hidden');
        discountRow.classList.add('flex');
        discountVal.textContent = `- Rs. ${discountAmt.toLocaleString()} (${techDiscount * 100}%)`;
      } else {
        discountRow.classList.add('hidden');
        discountRow.classList.remove('flex');
      }

      totalEl.textContent = `Rs. ${total.toLocaleString()}`;
    }

    document.getElementById('aurex-coupon-btn')?.addEventListener('click', () => {
      const code = document.getElementById('aurex-coupon').value.trim().toUpperCase();
      const msg = document.getElementById('aurex-coupon-msg');
      if (code === 'AUREX5') {
        techDiscount = 0.05;
        msg.textContent = '✓ 5% Hardware Discount applied!';
        msg.className = 'text-[11px] text-emerald-400 font-bold';
      } else {
        msg.textContent = 'Invalid code. Use AUREX5';
        msg.className = 'text-[11px] text-rose-400';
      }
      renderAurexCart();
    });

    window.addEventListener('DOMContentLoaded', renderAurexCart);
    window.addEventListener('aurex:cart_updated', renderAurexCart);
  </script>
</Layout>
