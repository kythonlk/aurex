---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "AUREX | Sri Lanka's Premier Retail Electronics & Gadgets Store", 
  description = "Shop genuine electronics in Sri Lanka with official manufacturer warranty. Flagship 5G phones, OLED laptops, ANC headphones, smartwatches & audio gear. Cash on Delivery & Koko installments available." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/hero-banner.jpg" />
  </head>
  <body class="min-h-screen flex flex-col bg-[#0b0f19] text-slate-200 selection:bg-[#00f0ff] selection:text-black">
    <!-- Top Tech Announcement Bar -->
    <div class="bg-[#050811] text-xs py-2 px-4 border-b border-cyan-900/40 text-center tracking-wider text-cyan-400 font-mono flex items-center justify-center gap-4">
      <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> 100% TRCSL APPROVED & GENUINE OFFICIAL WARRANTY</span>
      <span class="hidden md:inline">•</span>
      <span class="hidden md:inline">0% INTEREST 3-MONTH INSTALLMENTS WITH KOKO & MINTPAY</span>
      <span class="hidden md:inline">•</span>
      <span class="hidden md:inline">SAME-DAY COLOMBO DISPATCH</span>
    </div>

    <!-- Header Navigation -->
    <header class="sticky top-0 z-40 bg-[#0d1322]/90 backdrop-blur-md border-b border-slate-800 transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        <!-- Mobile Trigger -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-300 hover:text-cyan-400 focus:outline-hidden" aria-label="Toggle Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <img src="/images/logo.jpg" alt="Aurex Electronics Sri Lanka" class="w-11 h-11 rounded-lg object-cover border border-cyan-500/50 shadow-sm shadow-cyan-500/20 group-hover:scale-105 transition-transform" />
          <div class="flex flex-col">
            <span class="font-heading text-2xl font-black tracking-wider text-white group-hover:text-cyan-400 transition-colors">AUREX</span>
            <span class="text-[9px] tracking-[0.25em] text-cyan-400 uppercase font-mono">Retail Electronics • LK</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden lg:flex items-center space-x-7 text-sm font-medium">
          <a href="/" class="text-white hover:text-cyan-400 transition-colors">Home</a>
          <a href="/products?category=smartphones-tablets" class="text-slate-300 hover:text-cyan-400 transition-colors">Smartphones</a>
          <a href="/products?category=laptops-computing" class="text-slate-300 hover:text-cyan-400 transition-colors">Laptops & PCs</a>
          <a href="/products?category=audio-headphones" class="text-slate-300 hover:text-cyan-400 transition-colors">Audio & ANC</a>
          <a href="/products?category=smart-wearables" class="text-slate-300 hover:text-cyan-400 transition-colors">Smart Wearables</a>
          <a href="/products" class="text-cyan-400 hover:underline font-semibold font-mono text-xs">ALL GADGETS</a>
          <a href="/warranty" class="text-slate-300 hover:text-cyan-400 transition-colors">Warranty & Centers</a>
          <a href="/contact" class="text-slate-300 hover:text-cyan-400 transition-colors">Stores & Support</a>
        </nav>

        <!-- Actions -->
        <div class="flex items-center space-x-4">
          <a href="/products" class="text-slate-300 hover:text-cyan-400 p-2 transition-colors" aria-label="Search Catalog">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </a>

          <!-- Cart Trigger Button -->
          <button id="cart-drawer-btn" class="relative p-2.5 bg-slate-800 hover:bg-slate-700 text-cyan-400 rounded-lg border border-cyan-500/30 transition-colors focus:outline-hidden" aria-label="Open Cart">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span id="cart-count-badge" class="absolute -top-1.5 -right-1.5 bg-cyan-500 text-black text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center font-mono">0</span>
          </button>
        </div>
      </div>

      <!-- Mobile Menu Dropdown -->
      <div id="mobile-menu" class="hidden lg:hidden bg-[#0d1322] border-b border-slate-800 px-6 py-4 space-y-3 text-sm">
        <a href="/" class="block py-1.5 text-white font-semibold">Home</a>
        <a href="/products?category=smartphones-tablets" class="block py-1.5 text-slate-300">Smartphones & 5G</a>
        <a href="/products?category=laptops-computing" class="block py-1.5 text-slate-300">Laptops & Computing</a>
        <a href="/products?category=audio-headphones" class="block py-1.5 text-slate-300">Audio & Studio Gear</a>
        <a href="/products?category=smart-wearables" class="block py-1.5 text-slate-300">Smartwatches & Fitness</a>
        <a href="/products" class="block py-1.5 text-cyan-400 font-mono">Browse All Products</a>
        <a href="/warranty" class="block py-1.5 text-slate-300">Warranty Support</a>
        <a href="/contact" class="block py-1.5 text-slate-300">Store Locations</a>
      </div>
    </header>

    <!-- Page Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Slide-over Cart Drawer -->
    <div id="cart-drawer-backdrop" class="fixed inset-0 bg-black/75 z-50 opacity-0 pointer-events-none transition-opacity duration-300"></div>
    <aside id="cart-drawer-panel" class="fixed top-0 right-0 h-full w-full max-w-md bg-[#0f172a] z-50 shadow-2xl border-l border-cyan-900/50 transform translate-x-full transition-transform duration-300 flex flex-col">
      <!-- Header -->
      <div class="p-5 border-b border-slate-800 flex items-center justify-between bg-[#070b14]">
        <div class="flex items-center gap-2">
          <span class="font-heading text-lg font-bold text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
            Tech Cart
          </span>
          <span id="drawer-item-count" class="text-xs font-mono bg-cyan-950 text-cyan-400 border border-cyan-500/30 px-2 py-0.5 rounded-full">0 units</span>
        </div>
        <button id="cart-close-btn" class="text-slate-400 hover:text-white p-1" aria-label="Close Cart">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Items List -->
      <div id="drawer-items-list" class="flex-1 overflow-y-auto p-5 space-y-4 divide-y divide-slate-800">
        <!-- Injected dynamically -->
      </div>

      <!-- Footer & Checkout -->
      <div class="p-5 border-t border-slate-800 bg-[#090d16] space-y-3">
        <div class="flex justify-between items-center text-sm text-slate-400">
          <span>Subtotal</span>
          <span id="drawer-subtotal" class="font-bold text-white text-base font-mono">Rs. 0</span>
        </div>
        <div class="flex justify-between items-center text-xs text-cyan-400 font-mono">
          <span>Koko Installment Plan</span>
          <span id="drawer-koko">Rs. 0 x 3 Months</span>
        </div>
        <div class="pt-2 space-y-2">
          <a href="/checkout" class="block w-full py-3.5 px-4 text-center rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-black font-extrabold text-sm tracking-wider uppercase transition-all shadow-lg shadow-cyan-500/25">
            Proceed to Checkout
          </a>
          <button id="clear-cart-btn" class="w-full text-xs text-slate-500 hover:text-rose-400 py-1 transition-colors">
            Empty cart
          </button>
        </div>
        <div class="text-[10px] text-slate-500 text-center font-mono pt-1">
          🔒 PAYHERE 256-BIT SSL ENCRYPTED • CASH ON DELIVERY
        </div>
      </div>
    </aside>

    <!-- Footer -->
    <footer class="bg-[#070a12] text-slate-400 border-t border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
        <!-- Col 1 -->
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <img src="/images/logo.jpg" alt="Aurex Logo" class="w-10 h-10 rounded-md border border-cyan-500/40" />
            <span class="font-heading text-xl font-black text-white">AUREX</span>
          </div>
          <p class="text-xs leading-relaxed text-slate-400">
            Sri Lanka’s premier consumer electronics and smart technology retailer. Official agent warranties, authorized service backings, and genuine factory-sealed tech.
          </p>
          <div class="text-xs text-cyan-400 font-mono">
            Flagship Experience Center: Galle Road, Colombo 04
          </div>
        </div>

        <!-- Col 2: Categories -->
        <div>
          <h4 class="font-heading text-sm font-bold tracking-wider text-white uppercase mb-4">Hardware Categories</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/products?category=smartphones-tablets" class="hover:text-cyan-400 transition-colors">5G Flagship Smartphones</a></li>
            <li><a href="/products?category=laptops-computing" class="hover:text-cyan-400 transition-colors">Creators & OLED Laptops</a></li>
            <li><a href="/products?category=audio-headphones" class="hover:text-cyan-400 transition-colors">Hybrid ANC Studio Headphones</a></li>
            <li><a href="/products?category=smart-wearables" class="hover:text-cyan-400 transition-colors">Titanium AMOLED Smartwatches</a></li>
            <li><a href="/products?category=laptops-computing" class="hover:text-cyan-400 transition-colors">Curved Gaming Displays</a></li>
          </ul>
        </div>

        <!-- Col 3: Customer Care -->
        <div>
          <h4 class="font-heading text-sm font-bold tracking-wider text-white uppercase mb-4">Support & Services</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/warranty" class="hover:text-cyan-400 transition-colors">2-Year Sri Lanka Warranty Claim</a></li>
            <li><a href="/contact" class="hover:text-cyan-400 transition-colors">TRCSL Approval Verification</a></li>
            <li><a href="/contact" class="hover:text-cyan-400 transition-colors">Islandwide Courier Tracking</a></li>
            <li><a href="/contact" class="hover:text-cyan-400 transition-colors">Koko & Mintpay 0% Installments</a></li>
            <li><span class="text-cyan-400 font-mono">Direct Support: +94 11 450 7800</span></li>
          </ul>
        </div>

        <!-- Col 4: Newsletter -->
        <div>
          <h4 class="font-heading text-sm font-bold tracking-wider text-white uppercase mb-4">Tech Dispatch</h4>
          <p class="text-xs text-slate-400 mb-3">
            Get instant alerts when new flagship chipsets, graphic cards, and smartphones hit Sri Lanka.
          </p>
          <form id="tech-newsletter-form" class="space-y-2">
            <input type="email" required placeholder="name@domain.lk" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-hidden focus:border-cyan-400 font-mono" />
            <button type="submit" class="w-full py-2 bg-cyan-500 hover:bg-cyan-400 text-black font-bold text-xs rounded-lg uppercase tracking-wider transition-colors">
              Subscribe Alerts
            </button>
            <div id="tech-newsletter-alert" class="hidden text-xs text-cyan-400 text-center pt-1 font-mono">
              ✓ Subscribed to Aurex Dispatch.
            </div>
          </form>
        </div>
      </div>

      <div class="border-t border-slate-800/80 py-6 text-center text-xs text-slate-500">
        <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4">
          <p>© 2026 Aurex Electronics Sri Lanka. All Rights Reserved. Backed by Go Multi-Tenant High-Concurrence Engine.</p>
          <div class="flex items-center gap-3 text-cyan-400 text-xs font-mono">
            <span>🇱🇰 Sri Lanka Rupee (LKR)</span>
            <span>•</span>
            <span>PayHere & Cash on Delivery</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Aurex Cart Store JS -->
    <script is:inline>
      const AUREX_CART_KEY = 'aurex_cart_v1';

      function getAurexCart() {
        try {
          return JSON.parse(localStorage.getItem(AUREX_CART_KEY) || '[]');
        } catch {
          return [];
        }
      }

      function saveAurexCart(cart) {
        localStorage.setItem(AUREX_CART_KEY, JSON.stringify(cart));
        updateAurexCartUI();
      }

      window.addToAurexCart = function(product) {
        const cart = getAurexCart();
        const existing = cart.find(item => item.id === product.id);
        if (existing) {
          existing.quantity += (product.quantity || 1);
        } else {
          cart.push({
            id: product.id,
            title: product.title,
            price: product.price,
            image: product.image,
            quantity: product.quantity || 1,
            slug: product.slug
          });
        }
        saveAurexCart(cart);
        openAurexDrawer();
      };

      function updateAurexCartUI() {
        const cart = getAurexCart();
        const totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
        const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
        const kokoInst = Math.round(subtotal / 3);

        const badge = document.getElementById('cart-count-badge');
        if (badge) badge.textContent = String(totalCount);

        const drawerCount = document.getElementById('drawer-item-count');
        if (drawerCount) drawerCount.textContent = `${totalCount} unit${totalCount === 1 ? '' : 's'}`;

        const drawerSubtotal = document.getElementById('drawer-subtotal');
        if (drawerSubtotal) drawerSubtotal.textContent = `Rs. ${subtotal.toLocaleString()}`;

        const kokoElem = document.getElementById('drawer-koko');
        if (kokoElem) kokoElem.textContent = `Rs. ${kokoInst.toLocaleString()} x 3 Months`;

        const listContainer = document.getElementById('drawer-items-list');
        if (!listContainer) return;

        if (cart.length === 0) {
          listContainer.innerHTML = `
            <div class="py-12 text-center text-slate-500 space-y-3 font-mono">
              <svg class="w-12 h-12 mx-auto text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              <p class="text-sm">No hardware in your cart.</p>
              <a href="/products" class="inline-block text-xs text-cyan-400 hover:underline uppercase tracking-wider">
                Explore Gear →
              </a>
            </div>
          `;
          return;
        }

        listContainer.innerHTML = cart.map(item => `
          <div class="py-3 flex gap-3 items-center">
            <img src="${item.image}" alt="${item.title}" class="w-16 h-16 object-cover rounded-lg border border-slate-700 bg-slate-900" />
            <div class="flex-1 min-w-0">
              <h5 class="text-xs font-semibold text-white truncate">${item.title}</h5>
              <div class="text-xs text-cyan-400 font-mono mt-1 font-bold">Rs. ${item.price.toLocaleString()}</div>
              <div class="flex items-center gap-2 mt-2">
                <button onclick="changeAurexQty('${item.id}', -1)" class="w-6 h-6 bg-slate-800 rounded-sm flex items-center justify-center text-slate-300 hover:bg-slate-700 text-xs">-</button>
                <span class="text-xs font-mono px-2 text-white">${item.quantity}</span>
                <button onclick="changeAurexQty('${item.id}', 1)" class="w-6 h-6 bg-slate-800 rounded-sm flex items-center justify-center text-slate-300 hover:bg-slate-700 text-xs">+</button>
                <button onclick="removeAurexItem('${item.id}')" class="text-xs text-rose-400 hover:text-rose-300 ml-auto">Delete</button>
              </div>
            </div>
          </div>
        `).join('');
      }

      window.changeAurexQty = function(id, delta) {
        let cart = getAurexCart();
        const item = cart.find(i => i.id === id);
        if (item) {
          item.quantity += delta;
          if (item.quantity <= 0) {
            cart = cart.filter(i => i.id !== id);
          }
          saveAurexCart(cart);
        }
      };

      window.removeAurexItem = function(id) {
        let cart = getAurexCart();
        cart = cart.filter(i => i.id !== id);
        saveAurexCart(cart);
      };

      function openAurexDrawer() {
        const backdrop = document.getElementById('cart-drawer-backdrop');
        const panel = document.getElementById('cart-drawer-panel');
        if (backdrop && panel) {
          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          backdrop.classList.add('opacity-100');
          panel.classList.remove('translate-x-full');
          panel.classList.add('translate-x-0');
        }
      }

      function closeAurexDrawer() {
        const backdrop = document.getElementById('cart-drawer-backdrop');
        const panel = document.getElementById('cart-drawer-panel');
        if (backdrop && panel) {
          backdrop.classList.add('opacity-0', 'pointer-events-none');
          backdrop.classList.remove('opacity-100');
          panel.classList.add('translate-x-full');
          panel.classList.remove('translate-x-0');
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        updateAurexCartUI();

        document.getElementById('cart-drawer-btn')?.addEventListener('click', openAurexDrawer);
        document.getElementById('cart-close-btn')?.addEventListener('click', closeAurexDrawer);
        document.getElementById('cart-drawer-backdrop')?.addEventListener('click', closeAurexDrawer);

        document.getElementById('clear-cart-btn')?.addEventListener('click', () => {
          saveAurexCart([]);
        });

        document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
          document.getElementById('mobile-menu')?.classList.toggle('hidden');
        });

        document.getElementById('tech-newsletter-form')?.addEventListener('submit', (e) => {
          e.preventDefault();
          document.getElementById('tech-newsletter-alert')?.classList.remove('hidden');
          e.target.reset();
        });
      });
    </script>
  </body>
</html>
