---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Aurex | Appliances & Tech for Everyday Living', description = 'Dependable appliances and smart tech for every room, with local support and official warranty.' } = Astro.props;
const nav = [{ label: 'Shop all', href: '/products' }, { label: 'Fans & cooling', href: '/products?category=fans-cooling' }, { label: 'Kitchen', href: '/products?category=kitchen-appliances' }, { label: 'Tech', href: '/products?category=tech-computing' }, { label: 'Support', href: '/warranty' }];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><link rel="icon" type="image/svg+xml" href="/images/aurex-mark.svg" /><title>{title}</title><meta name="description" content={description} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:image" content="/images/hero-banner.jpg" /></head>
  <body class="min-h-screen flex flex-col"><div class="bg-[#172640] text-[#f6f1e8] text-[11px] font-bold tracking-[.08em]"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 min-h-9 flex items-center justify-center sm:justify-between gap-3"><span>FREE ISLANDWIDE DELIVERY ON ORDERS OVER RS. 10,000</span><span class="hidden sm:inline text-[#f4c665]">OFFICIAL WARRANTY INCLUDED</span></div></div>
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-[#e7e4de]"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[76px] flex items-center justify-between gap-5"><a href="/" class="flex items-center gap-2.5 group"><img src="/images/aurex-mark.svg" alt="" class="w-10 h-10 transition-transform group-hover:rotate-[-5deg] group-hover:scale-105" /><span class="font-heading text-2xl font-black tracking-[-.07em] text-[#172640]">aurex</span></a><nav class="hidden lg:flex items-center gap-6">{nav.map(link => <a href={link.href} class="text-[13px] font-bold text-[#42516a] hover:text-[#ef5b2a] transition-colors">{link.label}</a>)}</nav><div class="flex items-center gap-2"><a href="/products" class="hidden sm:grid place-items-center w-10 h-10 text-[#172640] hover:bg-[#f6f1e8] rounded-xl" aria-label="Browse products">⌕</a><button id="cart-drawer-btn" class="flex items-center gap-2 px-3 py-2.5 rounded-xl bg-[#172640] text-white text-xs font-bold hover:bg-[#283d60] transition-colors" aria-label="Open shopping bag">Bag <span id="cart-count-badge" class="grid place-items-center min-w-5 h-5 rounded-full bg-[#f4a62a] text-[#172640]">0</span></button><button id="mobile-menu-btn" class="lg:hidden p-2.5 text-[#172640]" aria-label="Toggle navigation">☰</button></div></div><div id="mobile-menu" class="hidden lg:hidden border-t border-[#e7e4de] px-4 py-3 bg-white">{nav.map(link => <a href={link.href} class="block py-2.5 text-sm font-bold text-[#42516a]">{link.label}</a>)}</div></header>
    <main class="flex-grow"><slot /></main>
    <footer class="bg-[#172640] text-[#c7d0dc] mt-auto"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-8"><div class="grid md:grid-cols-4 gap-10 pb-12 border-b border-white/10"><div><a href="/" class="flex items-center gap-2.5"><img src="/images/aurex-mark.svg" alt="" class="w-10 h-10"/><span class="font-heading text-2xl font-black tracking-[-.07em] text-white">aurex</span></a><p class="text-sm leading-relaxed mt-4 max-w-xs">Thoughtfully chosen appliances and technology, backed by people who are here to help.</p></div><div><h2 class="footer-heading">Shop</h2><a href="/products" class="footer-link">All products</a><a href="/products?category=fans-cooling" class="footer-link">Fans & cooling</a><a href="/products?category=kitchen-appliances" class="footer-link">Kitchen appliances</a></div><div><h2 class="footer-heading">Help & support</h2><a href="/warranty" class="footer-link">Warranty information</a><a href="/contact" class="footer-link">Contact us</a><a href="/contact" class="footer-link">Delivery & returns</a></div><div><h2 class="footer-heading">Stay in the loop</h2><p class="text-sm leading-relaxed mb-3">Offers, new arrivals, and useful home tips.</p><form id="aurex-newsletter" class="flex gap-2"><input required type="email" placeholder="Your email address" class="min-w-0 w-full rounded-lg border-0 px-3 py-2.5 text-sm text-[#172640]"/><button class="rounded-lg bg-[#f4a62a] px-3 text-sm font-bold text-[#172640] hover:bg-[#ffd070]">Join</button></form><p id="newsletter-confirmation" class="hidden text-xs text-[#f4c665] mt-2">Thanks — you’re on the list.</p></div></div><div class="pt-7 flex flex-col sm:flex-row gap-3 justify-between text-xs text-[#9ba9bc]"><span>© {new Date().getFullYear()} Aurex. All rights reserved.</span><span>Secure checkout · Official warranty · Islandwide delivery</span></div></div></footer>
    <div id="cart-drawer-backdrop" class="fixed inset-0 bg-[#172640]/40 z-50 opacity-0 pointer-events-none transition-opacity"></div><aside id="cart-drawer-panel" class="fixed top-0 right-0 h-full w-full max-w-md bg-white z-50 shadow-2xl translate-x-full transition-transform duration-300 flex flex-col"><div class="p-5 border-b border-[#e7e4de] flex items-center justify-between"><div><h2 class="font-heading font-extrabold text-[#172640]">Your bag</h2><span id="drawer-item-count" class="text-xs text-[#687386]">0 items</span></div><button id="cart-close-btn" class="p-2 text-[#172640]" aria-label="Close bag">✕</button></div><div id="drawer-items-list" class="flex-1 overflow-y-auto p-5 space-y-3"></div><div class="p-5 border-t border-[#e7e4de] bg-[#f7f7f5]"><div class="flex justify-between text-sm mb-4"><span>Subtotal</span><b id="drawer-subtotal" class="text-[#172640]">Rs. 0</b></div><a href="/checkout" class="btn-primary w-full justify-center">Secure checkout →</a><button id="clear-cart-btn" class="w-full text-xs text-[#687386] hover:text-[#ef5b2a] mt-3">Empty bag</button></div></aside>
    <script is:inline>
      const AUREX_CART_KEY = 'aurex_cart_v1';
      window.getAurexCart = () => { try { return JSON.parse(localStorage.getItem(AUREX_CART_KEY) || '[]'); } catch { return []; } };
      function saveCart(cart) { localStorage.setItem(AUREX_CART_KEY, JSON.stringify(cart)); updateCart(); }
      window.addToAurexCart = (product) => { const cart = window.getAurexCart(); const item = cart.find(entry => entry.id === product.id); if (item) item.quantity += product.quantity || 1; else cart.push({ id: product.id, title: product.title, price: product.price, image: product.image || product.images?.[0]?.url, quantity: product.quantity || 1, slug: product.slug }); saveCart(cart); openDrawer(); };
      function updateCart() { const cart = window.getAurexCart(), count = cart.reduce((sum, item) => sum + item.quantity, 0), total = cart.reduce((sum, item) => sum + item.price * item.quantity, 0); document.getElementById('cart-count-badge').textContent = count; document.getElementById('drawer-item-count').textContent = `${count} item${count === 1 ? '' : 's'}`; document.getElementById('drawer-subtotal').textContent = `Rs. ${total.toLocaleString()}`; const list = document.getElementById('drawer-items-list'); list.innerHTML = cart.length ? cart.map(item => `<div class="flex gap-3 border-b border-[#e7e4de] pb-3"><img src="${item.image}" alt="" class="w-16 h-16 rounded-lg object-cover bg-[#f6f1e8]"><div class="flex-1 min-w-0"><p class="font-bold text-sm text-[#172640] truncate">${item.title}</p><p class="text-xs text-[#687386] mt-1">Rs. ${item.price.toLocaleString()}</p><div class="flex gap-2 items-center mt-2"><button onclick="changeAurexQty('${item.id}',-1)" class="qty-btn">−</button><span class="text-xs font-bold">${item.quantity}</span><button onclick="changeAurexQty('${item.id}',1)" class="qty-btn">+</button><button onclick="removeAurexItem('${item.id}')" class="ml-auto text-xs text-[#ef5b2a]">Remove</button></div></div></div>`).join('') : '<div class="text-center py-16"><p class="font-heading font-bold text-[#172640]">Your bag is empty.</p><a class="text-sm text-[#ef5b2a] font-bold mt-2 inline-block" href="/products">Start shopping →</a></div>'; }
      window.changeAurexQty = (id, delta) => { let cart = window.getAurexCart(); const item = cart.find(entry => entry.id === id); if (item) { item.quantity += delta; if (item.quantity === 0) cart = cart.filter(entry => entry.id !== id); saveCart(cart); } }; window.removeAurexItem = id => saveCart(window.getAurexCart().filter(item => item.id !== id));
      function openDrawer() { document.getElementById('cart-drawer-backdrop').classList.replace('opacity-0', 'opacity-100'); document.getElementById('cart-drawer-backdrop').classList.remove('pointer-events-none'); document.getElementById('cart-drawer-panel').classList.replace('translate-x-full', 'translate-x-0'); } function closeDrawer() { document.getElementById('cart-drawer-backdrop').classList.replace('opacity-100', 'opacity-0'); document.getElementById('cart-drawer-backdrop').classList.add('pointer-events-none'); document.getElementById('cart-drawer-panel').classList.replace('translate-x-0', 'translate-x-full'); }
      document.addEventListener('DOMContentLoaded', () => { updateCart(); document.getElementById('cart-drawer-btn').onclick = openDrawer; document.getElementById('cart-close-btn').onclick = closeDrawer; document.getElementById('cart-drawer-backdrop').onclick = closeDrawer; document.getElementById('clear-cart-btn').onclick = () => saveCart([]); document.getElementById('mobile-menu-btn').onclick = () => document.getElementById('mobile-menu').classList.toggle('hidden'); document.getElementById('aurex-newsletter').onsubmit = event => { event.preventDefault(); document.getElementById('newsletter-confirmation').classList.remove('hidden'); event.target.reset(); }; });
    </script>
  </body></html>
